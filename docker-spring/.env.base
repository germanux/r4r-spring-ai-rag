# 1. SPRING, RAG Y OLLAMA
# Configuración pública activa. Contraseñas y tokens solo en .env privado.
# Los comentarios explican las variables; no desactivan ninguna.

# --- PostgreSQL — conexión de Spring y base de datos de pruebas ---
# Servidor PostgreSQL accesible desde Java fuera de Docker.
POSTGRES_HOST=192.168.1.203
# Puerto publicado de la base de datos principal.
POSTGRES_PORT=5432
# Nombre de la base de datos principal existente.
POSTGRES_DB=r4r_rag
# Usuario de la base principal; su contraseña pertenece al archivo privado.
POSTGRES_USER=r4r
# Puerto publicado de la base de datos de pruebas.
POSTGRES_TEST_PORT=5433
# Base de datos exclusiva para pruebas.
POSTGRES_TEST_DB=r4r_rag_test
# Usuario de la base de datos de pruebas.
POSTGRES_TEST_USER=r4r_test



# --- Ollama — generación local y failover ---
# Orden de generación: URL|modelo|timeout por proveedor; se vuelve al primero en cada consulta.
RAG_GENERATION_PROVIDERS=http://192.168.1.207:11434|qwen3:8b|20s,http://192.168.1.209:11434|qwen2.5:7b|60s
# Límite de conexión a cada proveedor local de generación.
RAG_GENERATION_CONNECT_TIMEOUT=2s
# Límite para comprobar la disponibilidad de un proveedor de generación.
RAG_GENERATION_PROBE_TIMEOUT=2s
# Límite de traducción local; se aplica también el timeout propio del proveedor.
# Activa o desactiva el modo de razonamiento de Ollama.
RAG_GENERATION_THINK=false
# Generación documental reproducible, sin variación creativa en listas y traducciones.
RAG_GENERATION_TEMPERATURE=0

# --- Ollama — embeddings y compatibilidad con el corpus ---
# Orden de embeddings: URL|timeout por proveedor; portátil, PC y NAS por defecto.
RAG_EMBEDDING_PROVIDERS=http://192.168.1.209:11434|8s,http://192.168.1.207:11434|8s,http://192.168.1.203:11434|30s
# Modelo común a todos los proveedores de embeddings.
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
# Dimensiones compatibles con los vectores almacenados; no cambiarlas sin validar el corpus.
RAG_EMBEDDING_DIMENSIONS=768
# Límite de conexión a un proveedor de embeddings.
RAG_EMBEDDING_CONNECT_TIMEOUT=1s
# Límite de comprobación del modelo instalado antes de generar embeddings.
RAG_EMBEDDING_PROBE_TIMEOUT=1s
# Presupuesto total de embeddings, incluidos los intentos fallidos.
RAG_EMBEDDING_TOTAL_TIMEOUT=35s
# Digest exigido para comprobar que todos los proveedores usan el modelo compatible.
RAG_EMBEDDING_EXPECTED_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f

# --- RAG — recuperación y documentos ---
# Número máximo de fragmentos solicitados a la búsqueda vectorial.
RAG_TOP_K=5
# Similitud mínima de recuperación; no reducirla para ocultar falta de evidencias.
# 70-case ES/EN retrieval: 0.70 loses 4 positives; no confirmed quality gain at 0.65. Keep baseline.
RAG_MIN_SCORE=0.63

# Optional review: URL|model[|timeout], or openai|model (shared remote quota).
RAG_AUDIT_ENABLED=false
RAG_AUDIT_PROVIDER=http://192.168.1.207:11434|qwen3:8b
# Nomic: seleccionar cinco resultados tras reordenar veinte candidatos válidos.
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=8
RAG_RETRIEVAL_LEXICAL_WEIGHT=0.10
# Ruta del directorio documental; debe ser accesible en el entorno de ejecución.
RAG_KNOWLEDGE_PATH=./knowledge
# Tamaño máximo permitido por archivo documental, en bytes.
RAG_MAX_FILE_BYTES=10485760
# Tamaño máximo configurado por fragmento, en caracteres.
RAG_MAX_CHUNK_CHARS=2000
# Activa el catálogo documental al iniciar; no es un permiso para reindexar.
RAG_CATALOG_ON_STARTUP=false

# --- Spring MVC — CORS y límites de consumo ---
# Lista única de orígenes autorizados, compartida por CORS y el filtro de seguridad.
RAG_CORS_ALLOWED_ORIGINS=https://athagon.tech,https://riansares.com,http://localhost:63342,http://127.0.0.1:63342,http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.203,https://192.168.1.203
# Activa la protección de los endpoints públicos del RAG.
RAG_API_SECURITY_ENABLED=true
# Intervalo mínimo entre consultas de una misma IP.
RAG_API_MIN_INTERVAL=5s
# Límite global de consultas por minuto.
RAG_API_GLOBAL_REQUESTS_PER_MINUTE=20
# Exige la cabecera Origin en las peticiones protegidas.
RAG_API_REQUIRE_ORIGIN=true
# Confía en cabeceras de IP reenviadas solo cuando el proxy sea de confianza.
RAG_API_TRUST_PROXY_HEADERS=false
# Máximo de IP distintas mantenidas en memoria por el limitador.
RAG_API_MAX_TRACKED_IPS=10000

# --- Spring MVC — seguimiento SSE y precarga ---
# Duración máxima del seguimiento de una consulta por SSE.
RAG_SSE_TIMEOUT=180s
# Intervalo de señales para mantener y comprobar la conexión SSE.
RAG_SSE_HEARTBEAT_INTERVAL=10s
# Solicita precarga local asíncrona tras el arranque; no invoca Luna.
RAG_WARMUP_ON_STARTUP=true
# Intervalo mínimo entre intentos de precarga.
RAG_WARMUP_MIN_INTERVAL=1m

# --- RAG — respaldo remoto Luna, independiente de S3 ---
# Habilita Luna únicamente como último respaldo técnico de generación.
RAG_OPENAI_ENABLED=false
# Modelo de OpenAI; la clave API se conserva exclusivamente en el archivo privado.
RAG_OPENAI_MODEL=gpt-6-luna
# Límite de espera para la respuesta del proveedor remoto.
RAG_OPENAI_READ_TIMEOUT=35s
# Máximo de intentos remotos diarios para limitar el consumo.
RAG_OPENAI_MAX_CALLS_PER_DAY=200

# --- RAG — almacenamiento vectorial y respaldo S3, independiente de Luna ---
# Almacén vectorial principal configurado.
RAG_VECTOR_PRIMARY=pgvector
# Activa el failover de lectura del almacén vectorial.
RAG_VECTOR_FAILOVER_ENABLED=false
# Recuperación PG bajo demanda: un intento compartido tras el cooldown, sin bucles.
RAG_PG_RECOVERY_INTERVAL=30s
# Espera máxima del pool/conexión PG y lectura JDBC; solo se aplican en modo failover.
RAG_PG_CONNECTION_TIMEOUT=3s
RAG_PG_SOCKET_TIMEOUT=5s
# Habilita el adaptador S3 Vectors; no activa Luna.
RAG_S3_VECTORS_ENABLED=false
# Región AWS del almacén de respaldo.
RAG_S3_VECTORS_REGION=eu-north-1
# Nombre verificado del bucket vectorial; vacío mientras no se configure.
RAG_S3_VECTORS_BUCKET=amzn-r4r-vectors
# Nombre verificado del índice vectorial; vacío mientras no se configure.
RAG_S3_VECTORS_INDEX=amzn-r4r-vector-index
# Límite de conexión del cliente S3 Vectors.
RAG_S3_VECTORS_CONNECT_TIMEOUT=1s
# Límite de tiempo por intento del cliente S3 Vectors.
RAG_S3_VECTORS_ATTEMPT_TIMEOUT=3s
# Límite total de una llamada S3 Vectors.
RAG_S3_VECTORS_CALL_TIMEOUT=4s

# Titan: tercer proveedor de lectura PG → S3/Nomic → Lambda; optativo, sin calibrar todavía.
RAG_TITAN_ENABLED=false
RAG_TITAN_FUNCTION=r4r-titan-retrieval
RAG_TITAN_REGION=eu-north-1
RAG_TITAN_TIMEOUT=5s
RAG_TITAN_MAX_TOP_K=20
# Obligatorio al activar; elegir con evaluación Titan, nunca copiar el umbral Nomic.
RAG_TITAN_MIN_SIMILARITY=

# --- Ollama — servicio de embeddings del NAS ---
# Dirección de escucha dentro del contenedor Ollama.
OLLAMA_HOST=0.0.0.0:11434
# Número de solicitudes que Ollama puede procesar en paralelo.
OLLAMA_NUM_PARALLEL=1
# Máximo de modelos cargados simultáneamente en Ollama.
OLLAMA_MAX_LOADED_MODELS=1
# Permanencia del modelo en memoria; -1 evita la descarga automática por inactividad.
OLLAMA_KEEP_ALIVE=-1

# --- Docker — DNS externo de API ---
# DNS externo de Docker para la API; usar resolutores LAN si la red bloquea DNS público.
# Docker mantiene la resolución interna de los servicios de r4r-network.
R4R_API_DNS_PRIMARY=1.1.1.1
R4R_API_DNS_SECONDARY=8.8.8.8

# --- Spring — modo de arranque ---
# Vacío mantiene Flyway normal; s3-readonly habilita recuperación de lectura sin PostgreSQL.
SPRING_PROFILES_ACTIVE=
