# Único archivo local: copiar a docker-spring/.env (junto al Compose en Synology).
# Sintaxis común: KEY=value sin comillas ni export, con valores sin espacios.
# Se admiten letras, números y, por ejemplo, ! @ % + = , . _ : / ? -.
# No usar $, barras inversas, comillas, acentos graves ni espacios: Java properties,
# Compose y Bash los interpretan de forma distinta; no existe un escape común.
# No versionar .env. Mantener la contraseña YA almacenada en ambos servidores.
POSTGRES_HOST=192.168.1.203
POSTGRES_PORT=5432
POSTGRES_DB=r4r_rag
POSTGRES_USER=r4r
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_DB=r4r_rag_test
POSTGRES_TEST_USER=r4r_test
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_EXISTENTE

# PC: host LAN y puertos anteriores. Docker API: postgres:5432 (Compose lo fija).
# Las variables del sistema y propiedades -D de Spring tienen precedencia sobre .env.
# Spring → Ollama del PC.
RAG_OLLAMA_BASE_URL=http://IP_DE_TU_PC:11434
RAG_GENERATION_MODEL=qwen3-coder-next-80b-t025-168k-8k-pc-pc:latest
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMENSIONS=768

# Configuración existente.
RAG_KNOWLEDGE_PATH=/tmp/r4r-knowledge
RAG_MAX_FILE_BYTES=10485760
RAG_MAX_CHUNK_CHARS=2000

# Seguridad mínima de la API pública RAG.
RAG_API_SECURITY_ENABLED=true
RAG_API_ALLOWED_ORIGIN_PUBLIC=https://athagon.tech
RAG_API_ALLOWED_ORIGIN_LOCALHOST=http://localhost:63342
RAG_API_ALLOWED_ORIGIN_LOOPBACK=http://127.0.0.1:63342
RAG_API_MIN_INTERVAL=20s
RAG_API_REQUIRE_ORIGIN=true
# Con acceso directo al puerto 18080: false.
# Con Cloudflare Tunnel/reverse proxy DE CONFIANZA y sin exponer el backend directamente: true.
RAG_API_TRUST_PROXY_HEADERS=false
RAG_API_MAX_TRACKED_IPS=10000


# Opcional: configuración existente de herramientas R4R.
R4R_OPENCODE_AGENT=r4r-pc
R4R_GALLERY_AGENT=r4r-gallery-pc
R4R_OPENCODE_PC_BASE_URL=http://127.0.0.1:11434/v1
R4R_OPENCODE_LP_BASE_URL=http://192.168.1.9:11434/v1
R4R_OPENCODE_ENDPOINT_CHECK=true
R4R_CODEGRAPH_POLICY=advisory
R4R_REQUIRE_CODEGRAPH=true
R4R_MAX_ATTEMPTS_PER_TASK=6
R4R_MAX_NO_PROGRESS_CYCLES=2
R4R_MAX_TRANSIENT_FAILURES=3
R4R_AUTO_COMMIT=true
R4R_LP_SAME_ERROR_THRESHOLD=3
R4R_LP_FALSE_COMPLETION_THRESHOLD=2

# Sound policy: changes (default), important, errors, all, or off.
# "changes" plays only the requested success MP3 after a real local-LLM file edit.
R4R_NOTIFICATION_MODE=changes
# Used only when the selected mode includes errors. Set 0 to disable rate limiting.
R4R_ERROR_SOUND_COOLDOWN_SECONDS=900

# The-Ring cognitive loop and cross-worker advisory exchange.
R4R_RING_REVIEW_INTERVAL_SECONDS=3600
R4R_RING_SESSION_TIMEOUT_SECONDS=5400
R4R_RING_DIRECTIVE_MAX_AGE_SECONDS=10800
R4R_RING_RUN_IMMEDIATELY=true

# Deterministic controller checkpoints and bounded OpenCode sessions.
# Models never write Git history; the Python controller creates checkpoints.
R4R_CHECKPOINT_ON_GREEN=true
R4R_OPENCODE_MAX_SESSION_SECONDS=5400
R4R_OPENCODE_IDLE_SECONDS=900
R4R_OPENCODE_MAX_SESSION_STEPS=120
R4R_OPENCODE_REPEAT_EVENT_BUDGET=12
R4R_PC_MAX_SESSION_SECONDS=5400
R4R_PC_IDLE_SECONDS=900
R4R_PC_MAX_SESSION_STEPS=120
R4R_PC_REPEAT_EVENT_BUDGET=12
R4R_LP_MAX_SESSION_SECONDS=3600
R4R_LP_IDLE_SECONDS=600
R4R_LP_MAX_SESSION_STEPS=90
R4R_LP_REPEAT_EVENT_BUDGET=12
R4R_RING_EVENT_MIN_INTERVAL_SECONDS=300

# Solo para Cloudflare Tunnel; conservar el token actual en Synology.
TUNNEL_TOKEN=
