# Copiar como r4r-test.env en el mismo directorio que docker-compose.yml.
# Sustituir el valor de POSTGRES_PASSWORD por una contrasena propia.
# Estas variables inicializan la base SOLAMENTE si postgres-test-data esta vacio.
POSTGRES_DB=r4r_rag_test
POSTGRES_USER=r4r_test
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_DE_TEST
