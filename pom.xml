<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.riansares</groupId>
    <artifactId>r4r-spring-ai-rag</artifactId>
    <version>0.3.3</version>
    <name>r4r-spring-ai-rag</name>
    <description>Minimal local RAG baseline with Spring AI, Ollama and PostgreSQL/pgvector</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.9</spring-ai.version>
        <aws-sdk.version>2.49.1</aws-sdk.version>
        <maven-failsafe.version>3.5.3</maven-failsafe.version>
        <r4r.test.postgres.enabled>false</r4r.test.postgres.enabled>
        <r4r.test.aws.enabled>false</r4r.test.aws.enabled>
        <r4r.test.titan.enabled>false</r4r.test.titan.enabled>
        <r4r.test.llm.enabled>false</r4r.test.llm.enabled>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>lambda</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3vectors</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                        <r4r.test.postgres.enabled>false</r4r.test.postgres.enabled>
                        <r4r.test.aws.enabled>false</r4r.test.aws.enabled>
                        <r4r.test.llm.enabled>false</r4r.test.llm.enabled>
                        <r4r.test.titan.enabled>false</r4r.test.titan.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven-failsafe.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <spring.profiles.active>test</spring.profiles.active>
                        <r4r.test.postgres.enabled>${r4r.test.postgres.enabled}</r4r.test.postgres.enabled>
                        <r4r.test.aws.enabled>${r4r.test.aws.enabled}</r4r.test.aws.enabled>
                        <r4r.test.llm.enabled>${r4r.test.llm.enabled}</r4r.test.llm.enabled>
                        <r4r.test.titan.enabled>${r4r.test.titan.enabled}</r4r.test.titan.enabled>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>titan-it</id>
            <properties><r4r.test.titan.enabled>true</r4r.test.titan.enabled></properties>
        </profile>
        <profile>
            <id>postgres-it</id>
            <properties>
                <r4r.test.postgres.enabled>true</r4r.test.postgres.enabled>
            </properties>
        </profile>
        <profile>
            <id>aws-it</id>
            <properties>
                <r4r.test.aws.enabled>true</r4r.test.aws.enabled>
            </properties>
        </profile>
        <profile>
            <id>llm-it</id>
            <properties>
                <r4r.test.llm.enabled>true</r4r.test.llm.enabled>
            </properties>
        </profile>
    </profiles>
</project>
