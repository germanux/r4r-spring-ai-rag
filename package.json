{
  "private": true,
  "scripts": {
    "config:check": "node ./scripts/resolve-r4r-config.mjs --destination PC --print && node ./scripts/resolve-r4r-config.mjs --destination LP --print",
    "agent:pc": "bash ./scripts/run-opencode-worker.sh --destination PC",
    "agent:lp": "bash ./scripts/run-opencode-worker.sh --destination LP",
    "agent:both": "bash ./scripts/run-r4r-agents-both.sh",
    "agent:status:pc": "bash ./scripts/run-opencode-worker.sh --destination PC --status",
    "agent:status:lp": "bash ./scripts/run-opencode-worker.sh --destination LP --status",
    "repos:list": "node ./scripts/sync-code-repositories.mjs --list",
