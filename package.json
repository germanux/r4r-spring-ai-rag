    "code:index": "node ./scripts/index-code-repositories.mjs",
    "code:index:cgr": "node ./scripts/index-code-repositories.mjs --cgr-only",
    "code:index:codegraph": "node ./scripts/index-code-repositories.mjs --codegraph-only",
