{
  "schema_version": 1,
  "plan_kind": "canonical-fullstack",
  "assignment_policy": {
    "mode": "ring-generated",
    "workers": [
      "PC",
      "LP"
    ],
    "workers_are_fullstack": true,
    "max_active_tasks_per_worker": 1,
    "overlapping_write_scopes": "forbidden",
    "directive_path": "runtime/control/<WORKER>/assignment.json"
  },
  "tasks": [
    {
      "id": "task-01-base",
      "command": ".opencode/commands/task-01-base.md",
      "objective": "Keep the Java, PostgreSQL, Flyway and Spring AI baseline green.",
      "allowed_paths": [
        "pom.xml",
        "src/**",
        "knowledge/**",
        "docker-postgres/**",
        "docs/backend/**",
        ".env.example",
        ".gitignore",
        "codegraph.json"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-01-base"
      ],
      "commit_message": "chore(task-01): establish green R4R baseline",
      "domain": "backend",
      "assignment": "RING_GENERATED",
      "depends_on": []
    },
    {
      "id": "task-02-ingestion",
      "command": ".opencode/commands/task-02-ingestion.md",
