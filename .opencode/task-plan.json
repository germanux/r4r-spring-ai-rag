        "src/main/**",
        "src/test/**",
        "knowledge/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-02-ingestion"
      ],
      "commit_message": "feat(task-02): add deterministic knowledge ingestion",
      "domain": "backend",
      "assignment": "RING_GENERATED",
      "depends_on": [
        "task-01-base"
      ]
    },
    {
