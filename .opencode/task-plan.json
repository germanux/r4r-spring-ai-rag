        "src/test/**",
        "knowledge/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-03-pgvector"
      ],
      "commit_message": "feat(task-03): add Spring AI pgvector retrieval",
      "domain": "backend",
      "assignment": "RING_GENERATED",
      "depends_on": [
        "task-02-ingestion"
      ]
    },
    {
      "id": "task-04-rag",
