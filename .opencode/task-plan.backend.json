{
  "schema_version": 1,
  "tasks": [
    {
      "id": "task-01-base",
      "command": ".opencode/commands/task-01-base.md",
      "objective": "Keep the Java, PostgreSQL, Flyway and Spring AI baseline green.",
      "allowed_paths": [
        "pom.xml",
        "src/**",
        "knowledge/**",
        "docker-postgres/**",
        "docs/backend/**",
        ".env.example",
        ".gitignore",
        "codegraph.json"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-01-base"
      ],
      "commit_message": "chore(task-01): establish green R4R baseline"
    },
    {
      "id": "task-02-ingestion",
      "command": ".opencode/commands/task-02-ingestion.md",
      "objective": "Implement deterministic and idempotent Markdown ingestion.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "knowledge/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-02-ingestion"
      ],
      "commit_message": "feat(task-02): add deterministic knowledge ingestion"
    },
    {
      "id": "task-03-pgvector",
      "command": ".opencode/commands/task-03-pgvector.md",
      "objective": "Persist and retrieve chunks through Spring AI PgVector.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "knowledge/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-03-pgvector"
      ],
      "commit_message": "feat(task-03): add Spring AI pgvector retrieval"
    },
    {
      "id": "task-04-rag",
      "command": ".opencode/commands/task-04-rag.md",
      "objective": "Implement a minimal cited non-web RAG service with abstention.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "knowledge/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-04-rag"
      ],
      "commit_message": "feat(task-04): add minimal cited RAG service"
    },
    {
      "id": "task-05-rag-api",
      "command": ".opencode/commands/task-05-rag-api.md",
      "objective": "Expose the cited RAG service through a stable JSON HTTP API for Angular.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "docs/backend/**"
      ],
      "gate": [
        "./scripts/task-gate.sh",
        "task-05-rag-api"
      ],
      "commit_message": "feat(task-05): expose cited RAG HTTP API"
    },
    {
      "id": "task-06-production-ingestion-cli",
      "command": ".opencode/commands/task-06-production-ingestion-cli.md",
      "objective": "Add an explicit non-web CLI for deterministic production knowledge ingestion.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "docs/backend/**",
        ".env.example"
      ],
      "gate": [
        "bash",
        "-lc",
        "rm -rf target && ./scripts/task-gate.sh all && mvn -Dtest=KnowledgeIngestionCliTest -DfailIfNoTests=true test"
      ],
      "commit_message": "feat(task-06): add production knowledge ingestion CLI"
    },
    {
      "id": "task-07-populate-production-rag",
      "command": ".opencode/commands/task-07-populate-production-rag.md",
      "objective": "Populate the persistent PC pgvector database and prove idempotent ingestion.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "docs/backend/**"
      ],
      "gate": [
        "bash",
        "-lc",
        "rm -rf target && ./scripts/task-gate.sh all && set -a && source ./.env && set +a && mvn -q -DskipTests spring-boot:run -Dspring-boot.run.main-class=com.riansares.r4r.ingestion.KnowledgeIngestionCli && rows=$(docker exec \"${POSTGRES_APP_CONTAINER:-r4r-postgres-app}\" psql -U \"${POSTGRES_APP_USER:-r4r}\" -d \"${POSTGRES_APP_DB:-r4r_rag}\" -Atqc 'SELECT count(*) FROM vector_store') && test \"$rows\" -gt 0"
      ],
      "commit_message": "feat(task-07): populate and verify production RAG corpus"
    },
    {
      "id": "task-08-rag-semantic-evaluation",
      "command": ".opencode/commands/task-08-rag-semantic-evaluation.md",
      "objective": "Add grounded retrieval, citation and abstention evaluation for the populated RAG.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "docs/backend/**"
      ],
      "gate": [
        "bash",
        "-lc",
        "rm -rf target && ./scripts/task-gate.sh all && mvn -Dtest=RagSemanticEvaluationTest -DfailIfNoTests=true test"
      ],
      "commit_message": "test(task-08): add semantic RAG evaluation"
    },
    {
      "id": "task-09-production-smoke",
      "command": ".opencode/commands/task-09-production-smoke.md",
      "objective": "Validate the packaged production RAG through real HTTP smoke acceptance.",
      "allowed_paths": [
        "pom.xml",
        "src/main/**",
        "src/test/**",
        "docs/backend/**"
      ],
      "gate": [
        "bash",
        "-lc",
        "rm -rf target && ./scripts/task-gate.sh all && mvn -Dtest=RagProductionSmokeTest -DfailIfNoTests=true test"
      ],
      "commit_message": "test(task-09): verify packaged production RAG"
    }
  ],
  "final_gate": [
    "./scripts/task-gate.sh",
    "all"
  ]
}
