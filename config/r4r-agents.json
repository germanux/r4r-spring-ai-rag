{
  "schemaVersion": 2,
  "defaults": {
    "requestTimeoutSeconds": 14400,
    "chunkTimeoutSeconds": 600,
    "maxAttemptsPerTask": 6,
    "maxNoProgressCycles": 2,
    "maxTransientFailures": 3,
    "autoCommit": true,
    "bootstrapCommit": false,
    "checkpointOnGreen": true,
    "maxSessionSeconds": 5400,
    "idleSeconds": 900,
    "maxSessionSteps": 30,
    "repeatEventBudget": 12,
    "contextDeltaBytes": 65536,
    "contextWarningTokens": 80000,
    "contextStopTokens": 120000
  },
  "orchestration": {
    "canonicalPlan": ".opencode/task-plan.json",
    "assignmentMode": "ring-generated",
    "logicalAgents": [
      "RING",
      "PC",
      "LP"
    ],
    "maxActiveTasksPerWorker": 1,
    "escalationAgent": "ESCALATION"
  },
  "codeIntelligence": {
    "referenceManifest": "knowledge/code-repositories.md",
    "referenceRoot": ".r4r/reference-repositories",
    "maxEnabledRepositories": 2,
    "codeGraph": {
      "enabled": true,
      "mcpName": "codegraph"
    },
    "codeGraphRag": {
      "enabled": true,
      "mcpName": "code_graph_rag",
      "package": "code-graph-rag[treesitter-full,semantic,ast-grep]==0.0.484",
      "workspace": "r4r-code",
      "endpointEnv": "R4R_CGR_BASE_URL",
      "modelEnv": "R4R_CGR_MODEL",
      "defaultEndpoint": "http://127.0.0.1:11434/v1",
      "defaultModel": "qwen3-coder-next-80b-t033-128k-8k-pc-pc:latest"
    }
  },
  "agents": {
    "RING": {
      "agentId": "r4r-ring",
      "role": "fullstack-coordinator-no-implementation",
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "modelLabel": "GPT-5.6 Luna",
      "reasoningVariant": "low",
      "worker": "opencode",
      "branch": "agent/ring-agent-worker",
      "plan": ".opencode/task-plan.json",
      "controlDir": "runtime/control/RING",
      "mayImplement": false
    },
    "ESCALATION": {
      "agentId": "r4r-escalation",
      "role": "on-demand-complex-analysis",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "modelLabel": "GPT-5.6 Sol",
      "reasoningVariant": "high",
      "worker": "opencode",
      "plan": ".opencode/task-plan.json",
      "controlDir": "runtime/control/ESCALATION",
      "persistentWorker": false
    },
    "PC": {
      "agentId": "r4r-pc",
      "branch": "agent/pc-qwen3-worker",
      "role": "fullstack-worker",
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "modelLabel": "GPT-5.6 Terra",
      "contextTokens": 1050000,
      "outputTokens": 128000,
      "temperature": 0.25,
      "worker": "opencode",
      "plan": ".opencode/task-plan.json",
      "progress": ".opencode/progress.pc.json",
      "legacyProgress": ".opencode/progress.backend.json",
      "memory": ".opencode/memory.pc.md",
      "legacyMemory": ".opencode/memory.backend.md",
      "controlDir": "runtime/control/PC",
      "allowedPaths": [
        "pom.xml",
        "src/**",
        "knowledge/**",
        "docker-postgres/**",
        "frontend/**",
        "docs/**",
        ".env.example",
        ".gitignore",
        "codegraph.json"
      ],
      "peerPaths": [],
      "mcp": [
        "codegraph",
        "code_graph_rag",
        "playwright"
      ],
      "runtime": {
        "maxSessionSeconds": 5400,
        "idleSeconds": 900,
        "maxSessionSteps": 30,
        "repeatEventBudget": 12
      }
    },
    "LP": {
      "agentId": "r4r-lp",
      "branch": "agent/laptop-qwen3-worker",
      "role": "fullstack-worker",
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "modelLabel": "GPT-5.6 Terra",
      "contextTokens": 1050000,
      "outputTokens": 128000,
      "temperature": 0.25,
      "worker": "opencode",
      "plan": ".opencode/task-plan.json",
      "progress": ".opencode/progress.lp.json",
      "legacyProgress": ".opencode/progress.frontend.json",
      "memory": ".opencode/memory.lp.md",
      "legacyMemory": ".opencode/memory.frontend.md",
      "controlDir": "runtime/control/LP",
      "allowedPaths": [
        "pom.xml",
        "src/**",
        "knowledge/**",
        "docker-postgres/**",
        "frontend/**",
        "docs/**",
        ".env.example",
        ".gitignore",
        "codegraph.json"
      ],
      "peerPaths": [],
      "mcp": [
        "codegraph",
        "code_graph_rag",
        "playwright"
      ],
      "runtime": {
        "maxSessionSeconds": 5400,
        "idleSeconds": 900,
        "maxSessionSteps": 30,
        "repeatEventBudget": 12
      }
    }
  }
}
