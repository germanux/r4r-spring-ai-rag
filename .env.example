# R4R local-development environment template.
# Copy to .env; do not commit real credentials.

POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_APP_CONTAINER=r4r-postgres-app
POSTGRES_APP_DB=r4r_rag
POSTGRES_APP_USER=r4r
POSTGRES_APP_PASSWORD=r4r_local_only
POSTGRES_APP_PORT=5432
POSTGRES_TEST_CONTAINER=r4r-postgres-test
POSTGRES_TEST_DB=r4r_rag_test
POSTGRES_TEST_USER=r4r_test
POSTGRES_TEST_PASSWORD=r4r_test_local_only
POSTGRES_TEST_PORT=55432

R4R_OPENCODE_AGENT=r4r-pc
R4R_GALLERY_AGENT=r4r-gallery-pc
R4R_OPENCODE_PC_BASE_URL=http://127.0.0.1:11434/v1
R4R_OPENCODE_LP_BASE_URL=http://192.168.1.9:11434/v1
R4R_OPENCODE_ENDPOINT_CHECK=true
R4R_CODEGRAPH_POLICY=advisory
R4R_REQUIRE_CODEGRAPH=true
R4R_MAX_ATTEMPTS_PER_TASK=6
R4R_MAX_NO_PROGRESS_CYCLES=2
R4R_MAX_TRANSIENT_FAILURES=2
R4R_AUTO_COMMIT=true
R4R_LP_MAX_SESSION_STEPS=90
R4R_LP_MAX_SESSION_SECONDS=5400
R4R_LP_REPEAT_EVENT_BUDGET=12
R4R_LP_SAME_ERROR_THRESHOLD=3
R4R_LP_FALSE_COMPLETION_THRESHOLD=2
