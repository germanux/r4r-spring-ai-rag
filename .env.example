# Docker Compose project
COMPOSE_PROJECT_NAME=r4r-spring-ai-rag
POSTGRES_IMAGE=pgvector/pgvector:pg16

# Persistent application database
POSTGRES_APP_CONTAINER=r4r-postgres-app
POSTGRES_APP_PORT=55432
POSTGRES_APP_DB=r4r_rag
POSTGRES_APP_USER=r4r
POSTGRES_APP_PASSWORD=r4r_local

# Disposable integration-test database
POSTGRES_TEST_CONTAINER=r4r-postgres-test
POSTGRES_TEST_PORT=55433
POSTGRES_TEST_DB=r4r_rag_test
POSTGRES_TEST_USER=r4r_test
POSTGRES_TEST_PASSWORD=r4r_test

# Spring/JDBC
RAG_DB_URL=jdbc:postgresql://127.0.0.1:55432/r4r_rag
RAG_DB_USER=r4r
RAG_DB_PASSWORD=r4r_local
RAG_TEST_DB_URL=jdbc:postgresql://127.0.0.1:55433/r4r_rag_test
RAG_TEST_DB_USER=r4r_test
RAG_TEST_DB_PASSWORD=r4r_test

# Spring AI / Ollama
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_GENERATION_MODEL=qwen3-coder-next-80b-t025-168k-8k-pc-pc
RAG_EMBEDDING_DIMENSIONS=768

# Knowledge loader
RAG_KNOWLEDGE_PATH=knowledge
RAG_MAX_FILE_BYTES=1048576
RAG_MAX_CHUNK_CHARS=2000

# OpenCode uses the OpenAI-compatible Ollama endpoint.
R4R_OPENCODE_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
R4R_OPENCODE_BIN=opencode
R4R_OPENCODE_AGENT=r4r-pc

# Optional strict-JSON reviewer command. Empty means REVIEW_PENDING.
R4R_CODEX_CMD_JSON=
