{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "r4r-pc",
  "share": "disabled",
  "snapshot": true,
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium"
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            },
            "max": {
              "reasoningEffort": "max",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium"
            }
          }
        }
      }
    }
  },
  "permission": {
    "codegraph_*": "deny",
    "code_graph_rag_*": "deny",
    "playwright_*": "deny"
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/codegraph-mcp.sh"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "code_graph_rag": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/cgr.sh",
        "mcp"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--viewport-size",
        "1440x1000",
        "--timeout-navigation",
        "90000",
        "--output-dir",
        "runtime/playwright"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".codegraph/**",
      ".cgr-runtime/**",
      ".r4r/reference-repositories/**",
      "runtime/**",
      "target/**",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "node_modules/**",
      "docker-postgres/data/**",
      "**/*.zip"
    ]
  },
  "enabled_providers": [
    "openai"
  ],
  "disabled_providers": [],
  "plugin": [
    "opencode-openai-codex-auth"
  ]
}
