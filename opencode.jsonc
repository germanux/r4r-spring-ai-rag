{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "r4r-laptop",
  "share": "disabled",
  "snapshot": true,
  "provider": {
    "ollama-pc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama PC - R4R",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 14400000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3-coder-next-80b-t025-168k-8k-pc-pc": {
          "name": "qwen3-coder-next-80b-t025-168k-8k-pc-pc",
          "limit": {
            "context": 172032,
            "output": 8192
          }
        },
        "qwen3-coder-next-80b-t025-168k-8k-pc-pc:latest": {
          "name": "qwen3-coder-next-80b-t025-168k-8k-pc-pc:latest",
          "limit": {
            "context": 172032,
            "output": 8192
          }
        }
      }
    },
    "ollama-laptop": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Laptop - R4R",
      "options": {
        "baseURL": "http://192.168.1.9:11434/v1",
        "timeout": 14400000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3-30b-coder-28k-6k-t33": {
          "name": "qwen3-30b-coder-28k-6k-t33",
          "limit": {
            "context": 28672,
            "output": 6144
          }
        },
        "qwen3-30b-coder-28k-6k-t33:latest": {
          "name": "qwen3-30b-coder-28k-6k-t33:latest",
          "limit": {
            "context": 28672,
            "output": 6144
          }
        }
      }
    }
  },
  "permission": {
    "codegraph_*": "deny",
    "code_graph_rag_*": "deny",
    "playwright_*": "deny"
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/codegraph-mcp.sh"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "code_graph_rag": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/cgr.sh",
        "mcp"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--viewport-size",
        "1440x1000",
        "--timeout-navigation",
        "90000",
        "--output-dir",
        "runtime/playwright"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".codegraph/**",
      ".cgr-runtime/**",
      ".r4r/reference-repositories/**",
      "runtime/**",
      "target/**",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "node_modules/**",
      "docker-postgres/data/**",
      "**/*.zip"
    ]
  },
  "enabled_providers": [
    "ollama-pc",
    "ollama-laptop"
  ],
  "disabled_providers": []
}
