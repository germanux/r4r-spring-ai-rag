{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "r4r-pc",
  "share": "disabled",
  "snapshot": true,
  "permission": {
    "codegraph_*": "deny",
    "code_graph_rag_*": "deny",
    "playwright_*": "deny"
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/codegraph-mcp.sh"
      ],
      "enabled": false,
      "timeout": 30000
    },
    "code_graph_rag": {
      "type": "local",
      "command": [
        "bash",
        "./scripts/cgr.sh",
        "mcp"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--viewport-size",
        "1440x1000",
        "--timeout-navigation",
        "90000",
        "--output-dir",
        "runtime/playwright"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".codegraph/**",
      ".cgr-runtime/**",
      ".r4r/reference-repositories/**",
      "runtime/**",
      "target/**",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "node_modules/**",
      "docker-postgres/data/**",
      "**/*.zip"
    ]
  }
}
