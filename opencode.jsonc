{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "r4r-pc",
  "share": "disabled",
  "snapshot": true,
  "provider": {
    "ollama-pc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama PC - R4R",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 14400000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3-coder-next-80b-t033-168k-8k-pc-pc:latest": {
          "name": "Qwen3-Coder-Next 80B PC 168K/8K",
          "temperature": true,
          "limit": {
            "context": 172032,
            "output": 8192
          }
        },
        "qwen3-coder-next-80b-t025-168k-8k-pc-pc:latest": {
          "name": "Qwen3-Coder-Next 80B PC 168K/8K",
          "temperature": true,
          "limit": {
            "context": 172032,
            "output": 8192
          }
        }
      }
    },
    "ollama-laptop": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Laptop - R4R",
      "options": {
        "baseURL": "http://192.168.1.9:11434/v1",
        "timeout": 14400000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3-30b-coder-28k-6k-t33:latest": {
          "name": "Qwen3 Coder 30B Laptop 28K/6K t33",
          "temperature": true,
          "limit": {
            "context": 28672,
            "output": 6144
          }
        }
      }
    }
  },
  "permission": {
    "codegraph_*": "deny",
    "playwright_*": "deny"
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 15000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--viewport-size",
        "1440x1000",
        "--timeout-navigation",
        "90000",
        "--output-dir",
        "runtime/playwright"
      ],
      "enabled": false,
      "timeout": 30000
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".codegraph/**",
      "runtime/**",
      "target/**",
      "dist/**",
      "node_modules/**",
      "docker-postgres/data/**",
      "patches-applied/**",
      "**/*.zip",
      "r4r-agent-update-v*/**",
      "r4r-agent-hotfix-v*/**"
    ]
  }
}
