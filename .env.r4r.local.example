# Machine-specific agent endpoints. Copy to .env.r4r.local and edit locally.
R4R_OPENCODE_PC_BASE_URL=http://127.0.0.1:11434/v1
R4R_OPENCODE_LP_BASE_URL=http://192.168.1.9:11434/v1

# Code-Graph-RAG uses these only for natural-language/Cypher queries.
# Embeddings are generated locally by its semantic backend.
R4R_CGR_BASE_URL=http://127.0.0.1:11434/v1
R4R_CGR_MODEL=qwen3-coder-next-80b-t033-128k-8k-pc-pc:latest

R4R_OPENCODE_BIN=opencode
R4R_CODEX_BIN=codex
R4R_CODEGRAPH_BIN=codegraph

# Code-Graph-RAG semantic indexing. CPU avoids competing with the loaded coding LLM.
R4R_CGR_EMBEDDING_DEVICE=cpu
R4R_CGR_EMBEDDING_BATCH_SIZE=8
